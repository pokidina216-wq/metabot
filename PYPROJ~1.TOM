[project]
name = "vexis"
version = "2.0.0"
description = "Vexis — SaaS Telegram Bot: metadata analysis, OSINT, username search"
requires-python = ">=3.12"
readme = "README.md"
license = {text = "MIT"}

dependencies = [
    "aiogram>=3.15.0",
    "aiohttp>=3.9.0",
    "sqlalchemy[asyncio]>=2.0.36",
    "asyncpg>=0.30.0",
    "alembic>=1.14.1",
    "redis[hiredis]>=5.2.1",
    "APScheduler>=3.10.4",
    "pydantic>=2.10.0",
    "pydantic-settings>=2.7.0",
    "python-dotenv>=1.0.1",
    "Pillow>=11.0.0",
    "mutagen>=1.47.0",
    "pypdf>=5.1.0",
    "python-docx>=1.1.2",
    "openpyxl>=3.1.5",
    "python-pptx>=1.0.2",
    "httpx>=0.28.0",
    "python-whois>=0.9.4",
    "dnspython>=2.7.0",
    "orjson>=3.10.0",
]

[build-system]
requires = ["setuptools>=68.0"]
build-backend = "setuptools.build_meta"

[tool.ruff]
target-version = "py312"
line-length = 100
